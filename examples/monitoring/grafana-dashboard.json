{
  "id": null,
  "uid": "tasker",
  "title": "Tasker",
  "tags": [
    "tasker",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tasker_queue_stats_up, job)",
          "refId": "job"
        },
        "definition": "label_values(tasker_queue_stats_up, job)",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "tasker",
          "value": "tasker"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tasker_queue_stats_up{job=\"$job\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(tasker_queue_stats_up{job=\"$job\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue state",
      "type": "timeseries",
      "description": "Database snapshot per instance. Do not sum snapshots from instances sharing one SQLite database. Missing data means the snapshot or scrape failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tasker_queue_tasks{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest overdue task",
      "type": "timeseries",
      "description": "Age past schedule time of the oldest due queued task. Zero when none are due. Expired leases are shown separately in Queue state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tasker_queue_oldest_due_age_seconds{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue delay and delivery duration p95",
      "type": "timeseries",
      "description": "Queue delay excludes future scheduling and retry backoff; recovery starts measuring at lease expiry. Delivery duration includes reading the response. No observations means no percentile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(tasker_queue_delay_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} queue delay",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(tasker_delivery_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} delivery",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Enqueue and persisted outcome rates",
      "type": "timeseries",
      "description": "Only committed task transitions. Failed outcomes include expired final attempts. Counters reset on process restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasker_tasks_enqueued_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} enqueued",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(tasker_tasks_finished_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Delivery attempt rates",
      "type": "timeseries",
      "description": "Completed delivery attempts independent of persistence. Success does not imply the task outcome was saved.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasker_delivery_attempts_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Retry and lease recovery rates",
      "type": "timeseries",
      "description": "Committed retries and expired leases reclaimed for another attempt.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasker_retries_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} retries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(tasker_lease_recoveries_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} recovered leases",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Deliveries in flight",
      "type": "timeseries",
      "description": "Current process deliveries, excluding ownership confirmation and outcome persistence.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tasker_deliveries_in_flight{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Storage error and lost lease rates",
      "type": "timeseries",
      "description": "Storage errors exclude expected empty results and cancellation. Lease ownership rejections are tracked separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasker_storage_errors_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{operation}} storage error",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(tasker_lease_lost_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{operation}} lease lost",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "API request rate",
      "type": "timeseries",
      "description": "Includes authentication failures and unmatched routes. Excludes metrics scrapes. Route and method labels are bounded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasker_http_requests_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{method}} {{route}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "API latency p95",
      "type": "timeseries",
      "description": "Request latency independent of access logging. Excludes metrics scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, method, route, le) (rate(tasker_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} {{method}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Process memory",
      "type": "timeseries",
      "description": "Process resident memory and currently allocated Go heap memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} resident",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "go_memstats_alloc_bytes{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} Go allocated",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Process CPU",
      "type": "timeseries",
      "description": "CPU seconds per second, equivalent to CPU cores used.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Goroutines",
      "type": "timeseries",
      "description": "Current Go goroutines by instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "Scrape and queue snapshot health",
      "type": "timeseries",
      "description": "1 means healthy, 0 means failed. A failed database snapshot omits queue counts and age while other metrics remain available.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "tasker_queue_stats_up{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} queue snapshot",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    }
  ]
}
